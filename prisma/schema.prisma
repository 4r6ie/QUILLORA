generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled (pgBouncer transaction mode) URL for serverless query traffic.
  url = env("DATABASE_URL")
  // Direct URL used only by migrations (prisma migrate deploy).
  directUrl = env("DIRECT_URL")
}

enum Role {
  reader
  author
  editor
  admin
}

enum ArticleStatus {
  draft
  in_review
  published
  archived
}

enum CommentStatus {
  pending
  approved
  rejected
}

/// Public author / reader profile. Mirrors a Supabase Auth user id.
model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  username  String   @unique
  fullName  String?  @map("full_name")
  bio       String?
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(reader)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles  Article[]
  comments  Comment[]
  bookmarks Bookmark[]

  @@index([role])
  @@map("profiles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  articles Article[]

  @@map("categories")
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  slug     String       @unique
  name     String
  articles ArticleTag[]

  @@map("tags")
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  title         String
  excerpt       String?
  content       String
  coverImageUrl String?       @map("cover_image_url")
  status        ArticleStatus @default(draft)
  readingTime   Int           @default(1) @map("reading_time")
  viewCount     Int           @default(0) @map("view_count")
  authorId      String        @map("author_id") @db.Uuid
  categoryId    String?       @map("category_id") @db.Uuid
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  author    Profile      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags      ArticleTag[]
  comments  Comment[]
  bookmarks Bookmark[]

  // Hot read paths (requirement 5): publishing feed, per-author feed,
  // per-category feed, and chronological feed.
  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId, status])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([status])
  @@map("articles")
}

model ArticleTag {
  articleId String @map("article_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("article_tags")
}

model Comment {
  id         String        @id @default(uuid()) @db.Uuid
  articleId  String        @map("article_id") @db.Uuid
  authorId   String?       @map("author_id") @db.Uuid
  authorName String?       @map("author_name")
  content    String
  status     CommentStatus @default(pending)
  createdAt  DateTime      @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId, status, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("comments")
}

model Bookmark {
  profileId String   @map("profile_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([profileId, articleId])
  @@index([articleId])
  @@map("bookmarks")
}

/// Fixed-window rate-limit counters (requirement 10). One row per
/// (key, window). Incremented atomically with upsert.
model RateLimitBucket {
  key         String   @map("key")
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Append-only audit trail for write-heavy admin actions (requirement 14:
/// read and write paths are separated; writes are auditable).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
