# QUILLORA environment template. Copy to .env.local (dev) or set in Vercel (prod).
# Never commit real secrets.

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=QUILLORA

# ---- Supabase (public, safe for the browser) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server-only, never expose to the browser) ------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Database (Prisma) ----------------------------------------------------
# Pooled connection (Supabase pooler, port 6543, transaction mode) for serverless
# query traffic. `pgbouncer=true` disables prepared statements, which are
# unsupported by the pooler.
DATABASE_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) used by Prisma migrations. Never used at request time.
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Optional read replica (Supabase read replicas). When set, all read queries are
# routed here; when empty, reads fall back to the primary pooled connection.
READ_DATABASE_URL=""

# ---- Cache / revalidation -------------------------------------------------
# Shared secret for POST /api/revalidate (Supabase webhooks, Realtime, CI).
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---- Monitoring / billing -------------------------------------------------
# Supabase Management API token (https://supabase.com/dashboard/account/tokens).
SUPABASE_MANAGEMENT_API_TOKEN=
SUPABASE_PROJECT_REF=
# Generic webhook (Slack/Discord/Teams) for usage + billing alerts.
ALERT_WEBHOOK_URL=
# Comma-separated emails for alert digests (logged if no mail provider is set).
ALERT_EMAILS=
# Token required by GET /api/monitor (in addition to editor/admin role).
MONITOR_TOKEN=
# Alert thresholds (USD/month and GB of Storage).
COST_ALERT_THRESHOLD=50
STORAGE_ALERT_THRESHOLD_GB=5
